{
  "name": "x402-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "x402 payment proxy with paywall support",
  "main": "server/src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "loadtest:proxy": "tsx scripts/loadtest-proxy.ts",
    "loadtest:proxy:autocannon": "tsx scripts/loadtest-proxy.ts --tool autocannon",
    "loadtest:proxy:k6": "tsx scripts/loadtest-proxy.ts --tool k6"
  },
  "keywords": [
    "x402",
    "proxy",
    "paywall",
    "payments"
  ],
  "license": "MIT",
  "dependencies": {
    "@x402/core": "^1.0.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "autocannon": "^7.15.0",
    "eslint": "^8.57.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}